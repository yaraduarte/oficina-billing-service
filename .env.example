NODE_ENV=development
PORT=3000
APP_ENV=local

# Mesmo segredo de assinatura dos JWT da Lambda de auth / os-service
JWT_SECRET=dev-secret
# Segredo injetado pelo API Gateway no header x-origin-verify. Vazio = verificação desligada (dev)
ORIGIN_VERIFY_SECRET=

# Mensageria da Saga (mesmo broker do os-service)
RABBITMQ_URL=amqp://oficina:oficina123@localhost:5672

# DynamoDB (em dev: DynamoDB Local do docker-compose)
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_AUTO_CREATE=true
QUOTES_TABLE=billing-quotes
PAYMENTS_TABLE=billing-payments
QUOTE_VALIDITY_HOURS=72

# Mercado Pago — credenciais da CONTA VENDEDORA DE TESTE (nunca commitar valores reais)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública do webhook (via API Gateway) e página de retorno do cliente
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_BACK_URL=

NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Oficina Marimbondo Billing
